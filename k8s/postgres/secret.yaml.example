# Real secrets go in a local secret.yaml (gitignored, never committed) —
# this file is the checked-in template documenting what's needed. Copy to
# secret.yaml and fill in the real value:
#   cp secret.yaml.example secret.yaml
#
# Same reasoning as the root .env/.env.example pair, just for a Kubernetes
# Secret object instead of a docker-compose env file.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: tinder
type: Opaque
stringData:
  # Fill in the real Postgres superuser name here — "postgres" (the same
  # value docker-compose.yml already uses) is fine for this dev build.
  POSTGRES_USER: ""
  # Fill in the real password here — "postgres" (same as docker-compose.yml
  # today) is fine for this dev build; a real deploy needs something
  # actually secret here.
  POSTGRES_PASSWORD: ""
  # Fill in the real database name here — "tinder" (same as
  # docker-compose.yml today) matches what every service's DATABASE_URL
  # already expects.
  POSTGRES_DB: ""
