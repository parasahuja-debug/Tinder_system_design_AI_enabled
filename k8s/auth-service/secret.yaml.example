# Real secrets go in a local secret.yaml (gitignored, never committed) —
# this file is the checked-in template documenting what's needed. Copy to
# secret.yaml and fill in the real value:
#   cp secret.yaml.example secret.yaml
#
# Same reasoning as the root .env/.env.example pair, just for a Kubernetes
# Secret object instead of a docker-compose env file.
apiVersion: v1
kind: Secret
metadata:
  name: auth-service-secret
  namespace: tinder
type: Opaque
stringData:
  # Fill in the real signing key here — for this dev build, the same
  # value docker-compose.yml already uses ("dev-secret-change-me") is
  # fine; a real deploy would put something actually random here.
  JWT_SECRET: ""
