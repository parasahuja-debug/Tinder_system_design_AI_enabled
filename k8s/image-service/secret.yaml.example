# Real secrets go in a local secret.yaml (gitignored, never committed) —
# this file is the checked-in template. Copy to secret.yaml and fill in
# the SAME real values already sitting in this project's root .env file
# (the exact variable names image_service/main.py reads via os.environ):
#   cp secret.yaml.example secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: image-service-secret
  namespace: tinder
type: Opaque
stringData:
  # Same value as .env's AWS_ACCESS_KEY_ID.
  AWS_ACCESS_KEY_ID: ""
  # Same value as .env's AWS_SECRET_ACCESS_KEY.
  AWS_SECRET_ACCESS_KEY: ""
  # Same value as .env's AWS_REGION — grouped here with the real
  # credentials rather than in the ConfigMap, even though a region name
  # alone isn't sensitive, just to keep every AWS-related value in one
  # place to fill in.
  AWS_REGION: ""
  # Same value as .env's S3_BUCKET_NAME.
  S3_BUCKET_NAME: ""
  # Same value as .env's CLOUDFRONT_DOMAIN.
  CLOUDFRONT_DOMAIN: ""
