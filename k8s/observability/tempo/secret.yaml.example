# Real secrets go in a local secret.yaml next to this file (gitignored by
# k8s/**/secret.yaml, never committed) — this is the checked-in template:
#   cp secret.yaml.example secret.yaml   # then fill in the blanks
#
# Tempo stores trace blocks in the SAME S3 bucket image-service uses, under
# its own traces/ prefix (see configmap.yaml). This has to be a separate
# Secret from k8s/image-service's: Secrets are namespace-scoped, and Tempo
# runs in `observability`, not `tinder`.
#
# Same credentials as image-service, matching what docker-compose does.
# Stricter alternative (deferred to Day 9 hardening): a dedicated IAM user
# whose policy only allows the bucket's traces/ prefix, so a leaked Tempo
# key couldn't touch user images.
#
# Key names are exactly what Tempo's config expands via
# -config.expand-env=true (${AWS_ACCESS_KEY_ID} etc.) — values are the same
# ones in this project's root .env.
apiVersion: v1
kind: Secret
metadata:
  name: tempo-secret
  namespace: observability
type: Opaque
stringData:
  # Same value as .env's AWS_ACCESS_KEY_ID.
  AWS_ACCESS_KEY_ID: ""
  # Same value as .env's AWS_SECRET_ACCESS_KEY.
  AWS_SECRET_ACCESS_KEY: ""
  # Same value as .env's AWS_REGION (e.g. ap-south-1).
  AWS_REGION: ""
  # Same value as .env's S3_BUCKET_NAME.
  S3_BUCKET_NAME: ""
