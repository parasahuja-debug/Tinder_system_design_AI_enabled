# Real values go in a local secret.yaml next to this file (gitignored by
# k8s/**/secret.yaml, never committed) — this is the checked-in template:
#   cp secret.yaml.example secret.yaml   # then fill in the blanks
#   kubectl apply -f secret.yaml
#
# Grafana's admin login. Compose used plain admin/admin inline; here it's a
# Secret so no password ever sits in a committed file (same rule as every
# other credential in k8s/).
#
# Names are Grafana's own convention: any env var starting with GF_ maps to
# a Grafana setting (GF_SECURITY_ADMIN_USER = [security] admin_user). The
# Deployment loads both via envFrom: secretRef.
apiVersion: v1
kind: Secret
metadata:
  name: grafana-secret
  namespace: observability
type: Opaque
stringData:
  # Username for Grafana's login page.
  GF_SECURITY_ADMIN_USER: ""
  # Password of your choice.
  GF_SECURITY_ADMIN_PASSWORD: ""
