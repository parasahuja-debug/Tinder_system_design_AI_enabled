# Real values go in a local secret.yaml next to this file (gitignored by
# k8s/**/secret.yaml, never committed) — this is the checked-in template:
#   cp secret.yaml.example secret.yaml   # then fill in the blanks
#   kubectl apply -f secret.yaml
#
# A COPY of the Postgres login, for postgres-exporter. It lives in
# `observability` (not next to Postgres in `tinder`), and Secrets can't be
# read across namespaces — so it can't reuse k8s/postgres's postgres-secret.
#
# !! If the Postgres password ever changes, update BOTH Secrets: this one and
#    postgres-secret in `tinder`. (The cost of keeping the exporter in
#    observability; the alternative was running it in `tinder` next to
#    Postgres, where it could read postgres-secret directly.)
#
# Names are postgres-exporter's own: it combines DATA_SOURCE_URI (set in
# deployment.yaml, not secret) with these two, so the password never
# appears inside a committed connection string — unlike compose's inline
# DATA_SOURCE_NAME=postgresql://postgres:postgres@db...
apiVersion: v1
kind: Secret
metadata:
  name: postgres-exporter-secret
  namespace: observability
type: Opaque
stringData:
  # Same value as POSTGRES_USER in k8s/postgres/secret.yaml.
  DATA_SOURCE_USER: ""
  # Same value as POSTGRES_PASSWORD in k8s/postgres/secret.yaml.
  DATA_SOURCE_PASS: ""
