# Real values go in a local secret.yaml next to this file (gitignored by
# k8s/**/secret.yaml) — this is the checked-in template:
#   cp secret.yaml.example secret.yaml   # fill in from the root .env
#   kubectl apply -f secret.yaml
#
# LangSmith tracing for the chatbot's model calls. OPTIONAL: the Deployment
# references this Secret with optional: true, so the chatbot runs without it
# (tracing simply off) until you create it.
apiVersion: v1
kind: Secret
metadata:
  name: support-chatbot-service-secret
  namespace: tinder
type: Opaque
stringData:
  # Same value as .env's LANGSMITH_API_KEY.
  LANGSMITH_API_KEY: ""
  # Same value as .env's LANGSMITH_TRACING (e.g. "true").
  LANGSMITH_TRACING: ""
  # Same value as .env's LANGSMITH_PROJECT.
  LANGSMITH_PROJECT: ""
