# Python virtualenv (committed by mistake earlier; never belongs in git)
tinder_venv/
venv/
.venv/

# Python bytecode / caches
__pycache__/
*.pyc
*.pyo

# Uploaded images live on local disk, keyed by rows in Postgres. Binaries must
# never be committed — the DB is the source of truth, the files are volatile.
image_store/

# Env files may hold real secrets (JWT secret, API keys) — keep them local.
.env
*.local.env

# Personal learning notes — not shipped documentation, stays local only.
LEARNING.md

# Production-scale rebuild plan (Kafka/Redis/Cassandra/S3/k8s/tracing) — a
# working exploration doc for a big, not-yet-finalized pivot (gateway choice
# still open), not settled documentation like humming-bubbling-valley.md.
# Stays local only, same reasoning as LEARNING.md above.
.claude/plans/cached-leaping-lovelace.md

# One-off interactive AWS setup wizard (Phase 4) — tied to this specific
# AWS account/console session, not a repeatable path for anyone else who
# clones this repo. Local only.
scripts/setup-aws-phase4.sh

# Editor / OS noise
.DS_Store
.idea/
.vscode/

# Angular build + deps (the frontend/ app added later this day)
frontend/node_modules/
frontend/dist/
frontend/.angular/

# --- Third-party community skills (mattpocock/skills, via `npx skills add`) ---
# The real skill files live in .agents/; the entries under .claude/skills/ are
# symlinks into it. We do NOT ship these by default — only skills we actually
# adopt get committed. So ignore the whole .agents/ tree and every skill under
# .claude/skills/, then explicitly un-ignore the ones we keep.
/.agents/
/.claude/skills/*
# Our own hand-written skills stay tracked.
!/.claude/skills/fastapi-endpoint/
!/.claude/skills/run-tinder/
# ...except its own installed deps (Playwright, for the driver script) —
# same reasoning as frontend/node_modules/ below: never commit node_modules.
/.claude/skills/run-tinder/node_modules/
# ADOPTION: to ship a mattpocock skill later, materialize it into a real tracked
# dir (copy .agents/skills/<name>/ -> .claude/skills/<name>/, replacing the
# symlink) and add a negation here, e.g.:
#   !/.claude/skills/teach/
# The `skills` CLI manifest lists the whole installed (not-shipped) set, so it's
# ignored too; adopted skills are tracked as real dirs, not via this lock.
/skills-lock.json
