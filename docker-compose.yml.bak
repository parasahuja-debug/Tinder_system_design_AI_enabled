# One compose file brings up the whole local system. Service names here double
# as DNS hostnames on the compose network, so they must match what nginx already
# expects (auth-service:8002, profile-service:8001).

services:
  # Single shared Postgres for every service. pgvector image (not stock
  # postgres) is chosen now so Day 5's chatbot can `CREATE EXTENSION vector`
  # without a late image swap. One DB, one table set per service.
  db:
    image: pgvector/pgvector:pg16
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: tinder # dedicated DB for this project; the image creates it on first init
    ports:
      - "5432:5432" # exposed to host so the Postgres MCP server / psql can inspect it
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      # Services wait on this so they don't race the DB and crash on startup.
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 3s
      retries: 10

  # Issues/verifies JWTs; owns the users table. Only service with JWT_SECRET.
  auth-service:
    build: ./auth_service
    environment:
      DATABASE_URL: postgresql://postgres:postgres@db:5432/tinder
      JWT_SECRET: dev-secret-change-me # dev only; a real deploy injects a real secret
    depends_on:
      db:
        condition: service_healthy
    expose:
      - "8002" # reachable only inside the compose network, never from the host

  # Profile data; trusts the gateway's X-User-Id header, never sees the token.
  profile-service:
    build: ./profile_service
    environment:
      DATABASE_URL: postgresql://postgres:postgres@db:5432/tinder
    depends_on:
      db:
        condition: service_healthy
    expose:
      - "8001"

  # Owns uploaded images: binary files on disk + a Postgres row per image.
  # Trusts the gateway's X-User-Id header, same as profile-service.
  image-service:
    build: ./image_service
    environment:
      DATABASE_URL: postgresql://postgres:postgres@db:5432/tinder
      IMAGE_STORE_DIR: /app/image_store
    depends_on:
      db:
        condition: service_healthy
    expose:
      - "8003"
    volumes:
      # Bind mount (not an anonymous volume): ties the container path to a
      # real folder in the repo, so uploaded files are visible on the host at
      # ./image_store/ and survive `docker compose down` — needed to actually
      # verify "file on disk matches DB row" from outside the container.
      - ./image_store:/app/image_store

  # Swipe decisions + match detection. Trusts the gateway's X-User-Id header,
  # same as profile-service/image-service. Owns the swipes/matches tables.
  matcher-service:
    build: ./matcher_service
    environment:
      DATABASE_URL: postgresql://postgres:postgres@db:5432/tinder
    depends_on:
      db:
        condition: service_healthy
    expose:
      - "8004"

  # Candidate-feed queries for Discover. Read-only: reads profiles/swipes/
  # images directly from the shared DB (see recommendation_service/main.py's
  # module docstring) rather than calling those services over HTTP, so it
  # only needs the DB itself, not the other services, to be up.
  recommendation-service:
    build: ./recommendation_service
    environment:
      DATABASE_URL: postgresql://postgres:postgres@db:5432/tinder
    depends_on:
      db:
        condition: service_healthy
    expose:
      - "8005"

  # Presence registry: tracks which users have a live chat WebSocket open
  # right now. In-memory only, no DB — see session_service/main.py's module
  # docstring for why this is its own service instead of living inside
  # direct-msg. Not in gateway's routes: only direct-msg ever calls it,
  # service-to-service.
  session-service:
    build: ./session_service
    expose:
      - "8006"

  # WebSocket chat between two matched users + persisted message history.
  # Calls auth-service, matcher-service, and session-service directly over
  # this network (see main.py's module docstring) rather than only reading
  # the shared DB, which is why it needs depends_on all three, not just db.
  direct-msg:
    build: ./direct_msg
    environment:
      DATABASE_URL: postgresql://postgres:postgres@db:5432/tinder
      AUTH_SERVICE_URL: http://auth-service:8002
      MATCHER_SERVICE_URL: http://matcher-service:8004
      SESSION_SERVICE_URL: http://session-service:8006
    depends_on:
      db:
        condition: service_healthy
      auth-service:
        condition: service_started
      matcher-service:
        condition: service_started
      session-service:
        condition: service_started
    expose:
      - "8007"

  # Local model server for the support chatbot — both the visible chat and
  # mem0's own summarization run on a model pulled here, not the Claude API
  # (see support_chatbot_service/CLAUDE.md for the reasoning: a high-
  # frequency, low-stakes workload like this doesn't need to spend Claude
  # tokens). Sealed inside the compose network like every backend service —
  # never exposed to the host or the gateway.
  #
  # Bind-mounted to the HOST's own Ollama data dir (~/.ollama), not a fresh
  # named volume: discovered during Day 5 verification that pulling a new
  # model from inside the container meant a slow multi-GB download the host
  # already had sitting on disk from prior Ollama use outside this project.
  # Sharing the directory means this container sees whatever's already
  # pulled (llama3.2, nomic-embed-text, ...) with zero new downloads. A
  # pragmatic, dev-only choice — two Ollama processes (host + container)
  # reading/writing the same directory concurrently would be a real risk in
  # anything other than a single-developer local setup, but here it's the
  # same person's own machine either way.
  ollama:
    image: ollama/ollama:latest
    volumes:
      - ${HOME}/.ollama:/root/.ollama
    expose:
      - "11434"

  # RAG + memory support chatbot — the one service that calls a model at
  # runtime. See support_chatbot_service/CLAUDE.md for the full
  # architecture (both widget modes, the two-layer memory, the MCP-guarded
  # live-data tools). README.md is bind-mounted read-only so it always
  # embeds whatever the file currently says, no rebuild needed.
  support-chatbot-service:
    build: ./support_chatbot_service
    environment:
      DATABASE_URL: postgresql://postgres:postgres@db:5432/tinder
      AUTH_SERVICE_URL: http://auth-service:8002
      OLLAMA_HOST: http://ollama:11434
      LANGSMITH_API_KEY: ${LANGSMITH_API_KEY}
      LANGSMITH_TRACING: ${LANGSMITH_TRACING}
      LANGSMITH_PROJECT: ${LANGSMITH_PROJECT}
    depends_on:
      db:
        condition: service_healthy
      auth-service:
        condition: service_started
      ollama:
        condition: service_started
    expose:
      - "8008"
    volumes:
      - ./README.md:/app/README.md:ro

  # nginx: the only thing clients talk to. Routes + gates protected routes via
  # auth_request. Config is mounted (not baked) so edits don't need a rebuild.
  gateway:
    image: nginx:1.27-alpine
    volumes:
      - ./gateway/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./gateway/conf.d:/etc/nginx/conf.d:ro
    ports:
      - "8080:8080"
    depends_on:
      - auth-service
      - profile-service
      - image-service
      - matcher-service
      - recommendation-service
      - direct-msg
      - support-chatbot-service

  # Dev-only browser UI for the DB (the "Studio-like" page). It speaks HTTP to
  # you on 8081 and the Postgres wire protocol to `db` internally — which is why
  # you can't just point a browser at 5432. sslmode=disable because our local
  # Postgres has no TLS. Not part of the app; purely for inspecting tables/rows.
  pgweb:
    image: sosedoff/pgweb:latest
    environment:
      PGWEB_DATABASE_URL: postgresql://postgres:postgres@db:5432/tinder?sslmode=disable
    ports:
      - "8081:8081"
    depends_on:
      db:
        condition: service_healthy

volumes:
  pgdata: # named volume so DB data survives `docker compose down`
