# Real secrets go in a local .env (gitignored, never committed) — this file
# is the checked-in template documenting which keys the repo needs and
# where to get them. Copy to .env and fill in the real value:
#   cp .env.example .env

# LangSmith traces every support_chatbot_service model call (see
# support_chatbot_service/CLAUDE.md). Free "Developer" tier covers this
# build week easily (5,000 traces/month). Get a key at
# https://smith.langchain.com after creating a free account.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=tinder-support-chatbot

# Which Ollama models support_chatbot_service uses — must already be pulled
# (see README.md's "Try the support chatbot" section). Two different models
# for two different jobs, not one for both: CHAT_MODEL needs to be fast (it
# runs on every chat turn), MEM0_LLM_MODEL needs to reliably follow a
# structured-JSON prompt (it only runs once per closed session) — a smaller
# model that's great at the first job was unreliable at the second (see
# support_chatbot_service/config.py).
CHAT_MODEL=llama3.2
MEM0_LLM_MODEL=mistral:7b-instruct-v0.3-q4_K_M
MEM0_EMBED_MODEL=nomic-embed-text
